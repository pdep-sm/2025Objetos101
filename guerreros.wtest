import guerreros.*
import zonas.*
import armas.*

describe "Pruebas de entrega 1 de TP de Tierra Media" {
  const espadaDeFrodo = new Espada(origen = elfico, multiplicadorDePoder = 8)
  const frodo = new Hobbit(vida = 50, armas = #{espadaDeFrodo})
  const gimli = new Enano(
    vida = 75, 
    factorDePoder = 3, 
    armas = #{self.hachaDeGimli(), self.hachaDeGimli()}
  )
  const arcoDeLegolas = new Arco(longitud = 110)
  const espadaDeLegolas = new Espada(origen = elfico, multiplicadorDePoder = 12)
  const legolas = new Elfo(vida = 80, destrezaPropia = 1, armas = #{arcoDeLegolas, espadaDeLegolas})
  const anduril = new Espada(origen = elfico, multiplicadorDePoder = 18)
  const aragorn = new Humano(vida = 85, limitadorDePoder = 20, armas = #{anduril})
  const glamdring = new Espada(origen = elfico, multiplicadorDePoder = 10)
  const baculoDeGandalf = new Baculo(poder = 400)
  const gandalf = new Maia(vida = 100)

  method initialize() {
    gandalf.agregarArma(baculoDeGandalf)
    gandalf.agregarArma(glamdring)
  }

  method hachaDeGimli() = new Hacha(largoMango = 70, pesoHoja = 5)

  // Poder de Gandalf con distintas configuraciones
  test "Poder de Gandalf básico con báculo y vida 100" {
    gandalf.quitarArma(glamdring)
    assert.equals(2300, gandalf.poder())
  }

  test "Poder de Gandalf en peligro de vida con báculo y vida 10" {
    gandalf.vida(10)
    gandalf.quitarArma(glamdring)
    assert.equals(3800, gandalf.poder())
  }

  test "Poder de Gandalf básico con espada élfica y vida 100" {
    gandalf.quitarArma(baculoDeGandalf)
    assert.equals(2100, gandalf.poder())
  }

  test "Frodo sin items tiene 290 de poder" {
    assert.equals(290, frodo.poder())
  }

  test "Gimli tiene 2175 de poder" {
    assert.equals(2175, gimli.poder())
  }

  test "Poder de Legolas" {
    assert.equals(2480, legolas.poder())
  }

  test "Poder de Legolas con medio punto extra de destreza" {
    legolas.destrezaPropia(1.5)
    assert.equals(2880, legolas.poder())
  }

  test "Poder de Aragorn" { //TODO Agregar daga
    assert.equals(2295, aragorn.poder())
  }

  test "Poder de Gandalf" { 
    assert.equals(2900, gandalf.poder())
  }

  test "Poder de Gandalf con 9 de vida" {
    gandalf.vida(9)
    assert.equals(4100, gandalf.poder())
  }

}